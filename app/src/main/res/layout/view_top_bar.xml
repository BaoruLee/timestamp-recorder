<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部玻璃栏（跑在独立窗口里，模糊由系统做）。
     ⚠️ 布局要点：标题与副标题竖着一组，「⋮」**垂直居中于整块栏**（而不是只居中标题那一行）。
     这样 ⋮ 的下沿就非常接近栏底 —— 菜单挂在它正下方展开时，离按钮只有几 dp，
     不会像之前那样中间还隔着一行副标题的落差。statusBar 的内边距由代码加在根布局上。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topBarRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/topTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/main_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/topSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/main_subtitle"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_more"
        android:scaleType="center"
        android:src="@drawable/ic_more_vert" />
</LinearLayout>
