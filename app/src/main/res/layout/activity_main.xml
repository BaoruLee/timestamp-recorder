<?xml version="1.0" encoding="utf-8"?>
<!-- 主页：底部「事件 / 时间线」双 Tab。

     底栏（悬浮胶囊岛）的两种形态（由 MainActivity.syncBarMode 运行时决定）：
     ① 系统能提供「窗口背景模糊」（HyperOS 高级材质，且用户开关是开的）→ 胶囊岛被放进一个
        独立窗口，模糊由系统合成器完成，App 端零开销；此时布局里的 bottomBar 会被隐藏；
     ② 否则 → 用布局里的 bottomBar：半透明静态胶囊（`bg_bottom_nav`），完全不模糊。
     两个形态共用同一份 Tab 文字与位置坐标，切换时不需要改布局。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main_gradient">

        <!-- 时间线底轨（只在「时间线」Tab 显示）：贯穿屏幕上下的一条淡线。
             放在最前面 = 画在最底层，所以它在工具栏玻璃之下也能透出来，
             彩色段（各列表项）叠在它上面，于是整条线从屏幕顶端连绵到手势条上方。 -->
        <View
            android:id="@+id/timelineTrack"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/timeline_line_inset"
            android:background="@drawable/timeline_track"
            android:visibility="gone" />

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_bar"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:contentInsetEnd="4dp"
                app:title="@string/main_title"
                app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge">

                <!-- 「⋮」用自定义按钮而不是 options menu：这样点它弹的是我们那块玻璃菜单，
                     位置也完全可控（系统 PopupMenu 的样式和定位都跟这套玻璃语言不搭）。 -->
                <ImageButton
                    android:id="@+id/btnMore"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_more"
                    android:scaleType="center"
                    android:src="@drawable/ic_more_vert" />
            </com.google.android.material.appbar.MaterialToolbar>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingBottom="12dp"
                android:text="@string/main_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- 内容区：ViewPager2 承载「事件 / 时间线」两页 ——
             跟手横滑、可急停、可反向拖回，是 AndroidX 的标准页面容器；
             Tab 胶囊滑块通过 onPageScrolled 与它逐帧联动。 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- 液态玻璃快捷按钮：位置可在设置页切换（左/中/右），上移至底部 Tab 栏上方 -->
        <ImageButton
            android:id="@+id/fabAdd"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/fab_liquid"
            android:contentDescription="@string/fab_add"
            android:elevation="6dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:outlineProvider="background"
            android:scaleType="center"
            android:src="@drawable/ic_add" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 底栏 = 悬浮胶囊岛（布局内形态）。
         左右各留 16dp；离手势条 12dp（bottomMargin 由代码再加上导航栏高度）。
         背景 = bg_bottom_nav 的**半透明静态胶囊**；是否做模糊由 MainActivity.syncBarMode 运行时决定
         （系统能给就换成独立窗口版，那时这个 bottomBar 会被隐藏）。 -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_bar_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        android:background="@drawable/bg_bottom_nav">

        <com.timestamp.recorder.TabSliderView
            android:id="@+id/tabSlider"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/tabContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- 与独立窗口版（view_bottom_nav.xml）保持完全一致的结构与 id -->
            <LinearLayout
                android:id="@+id/tabEvents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconEvents"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tab_events" />

                <TextView
                    android:id="@+id/textEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="@string/tab_events"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabTimeline"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconTimeline"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tab_timeline" />

                <TextView
                    android:id="@+id/textTimeline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="@string/tab_timeline"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
