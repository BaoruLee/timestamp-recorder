<?xml version="1.0" encoding="utf-8"?>
<!-- 主页：BlurView 重构版。
     顶部额头和底部岛均用 BlurView 做实时背后模糊，状态栏配色由 Activity 主窗口控制。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main_gradient">

        <!-- 时间线底轨 -->
        <View
            android:id="@+id/timelineTrack"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/timeline_line_inset"
            android:background="@drawable/timeline_track"
            android:visibility="gone" />

        <!-- 内容区：从屏幕顶端开始铺（去掉 scrolling behavior），
             滚动时内容从顶部玻璃栏底下穿过，BlurView 才能模糊到内容。
             顶部 padding 由代码动态设置（等于 AppBar 高度），初始内容不被挡住。 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <!-- 顶部模糊背景层（BlurView）：在 ViewPager2 上面、AppBarLayout 下面，
             模糊背后的列表内容，AppBarLayout 透明背景透出模糊。 -->
        <eightbitlab.com.blurview.BlurView
            android:id="@+id/topBlur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:contentInsetEnd="4dp"
                app:title="@string/main_title"
                app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge">

                <ImageButton
                    android:id="@+id/btnMore"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_more"
                    android:scaleType="center"
                    android:src="@drawable/ic_more_vert" />
            </com.google.android.material.appbar.MaterialToolbar>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingBottom="12dp"
                android:text="@string/main_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- 加号按钮 -->
        <ImageButton
            android:id="@+id/fabAdd"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/fab_liquid"
            android:contentDescription="@string/fab_add"
            android:elevation="6dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:outlineProvider="background"
            android:scaleType="center"
            android:src="@drawable/ic_add" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 底部岛：BlurView 直接作为容器，模糊背后的列表内容 -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_bar_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        android:background="@drawable/bg_bottom_nav">

        <com.timestamp.recorder.TabSliderView
            android:id="@+id/tabSlider"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/tabContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/tabEvents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconEvents"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tab_events" />

                <TextView
                    android:id="@+id/textEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="@string/tab_events"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabTimeline"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconTimeline"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_tab_timeline" />

                <TextView
                    android:id="@+id/textTimeline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="@string/tab_timeline"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</FrameLayout>
