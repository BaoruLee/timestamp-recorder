<?xml version="1.0" encoding="utf-8"?>
<!-- 胶囊岛的内容（跑在独立窗口里）。
     ⚠️ 这里**不要**写背景：玻璃背景这次交给**窗口自身**（见 MainActivity 的
     `w.setBackgroundDrawable(bg_bottom_nav)`）—— 因为范围受限的 background blur
     很可能就是按「窗口背景」来推导模糊区域的，把窗口背景设成全透明会让它无处可糊。

     ⚠️ Tab 用「ImageView + TextView」而不是 TextView 的 compound drawable：
     compound drawable 与文字之间的距离由系统排版决定，`drawablePadding` 给 6dp 实测
     视觉上却拉开近 60dp，根本控不住。拆成两个 View 后用 layout_marginStart 精确控距。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/islandRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 选中态滑块：一块会滑动的玻璃胶囊（压在 Tab 内容下层，位置/尺寸由代码算，
         切 Tab 时 220ms 平滑滑过去）。压在下层 = 在 XML 里排在 tabContent 前面。 -->
    <com.timestamp.recorder.TabSliderView
        android:id="@+id/tabSlider"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/tabContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/tabEvents"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconEvents"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tab_events" />

            <TextView
                android:id="@+id/textEvents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/tab_events"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabTimeline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconTimeline"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tab_timeline" />

            <TextView
                android:id="@+id/textTimeline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/tab_timeline"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
