<?xml version="1.0" encoding="utf-8"?>
<!-- 底栏胶囊岛的静态玻璃背景（API < 33 没有 AGSL shader 时用它兜底；
     有 shader 时 MainActivity 会把这个背景置空，玻璃交给 shader 实时画）。
     圆角 = 28dp = 岛高 56dp 的一半，所以是完整胶囊。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#F2FFFFFF"
                android:endColor="#E6FFFFFF" />
        </shape>
    </item>
    <!-- 玻璃边缘一圈细高光（胶囊的"厚度感"） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
