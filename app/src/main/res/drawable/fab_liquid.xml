<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃（Liquid Glass）风格按钮背景：半透明渐变 + 边缘高光 + 顶部光斑 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 玻璃本体：半透明白色渐变 -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#E8FFFFFF"
                android:centerColor="#B8FFFFFF"
                android:endColor="#70FFFFFF" />
        </shape>
    </item>
    <!-- 顶部高光光斑 -->
    <item
        android:insetTop="4dp"
        android:insetLeft="4dp"
        android:insetRight="38dp"
        android:insetBottom="38dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#A6FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <!-- 边缘描边（液态高光边） -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
