<?xml version="1.0" encoding="utf-8"?>
<!-- 快捷「＋」按钮 · 浅色。
     与底部 Tab 栏用同一套玻璃材质（同色系渐变 + 同 1dp 描边），观感统一；
     不再用旧版那块偏心的「顶部光斑」，避免和底栏不是一家人。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#F2FFFFFF"
                android:endColor="#E8FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
