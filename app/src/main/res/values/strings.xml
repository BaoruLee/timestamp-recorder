    <string name="about_title">关于</string>
    <string name="about_about">关于本项目</string>
    <string name="about_desc">一款完全离线、零权限的时间戳记录工具：在 App 内或桌面小组件单击，即可为任意事件快速记下一笔当前时间。支持备注与标签（规划中）。</string>
    <string name="about_open_source">开源与字体</string>
