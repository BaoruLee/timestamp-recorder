<?xml version="1.0" encoding="utf-8"?>
<!-- 快捷「＋」按钮 · 深色：与底部 Tab 栏深色玻璃同色系，观感统一。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#F2141218"
                android:endColor="#E6141218" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
